# Normalize line endings across contributors' machines. This repo ships shell
# (install.sh, scripts/*.sh) that must run identically on every checkout, so
# text files are stored and checked out with LF.
* text=auto eol=lf
*.sh text eol=lf

# Raw model outputs and judge replies are data: keep them byte-exact (trailing spaces are markdown line breaks).
docs/bench/rows-1017/**/outputs/** -whitespace
docs/bench/rows-1017/**/judge_*/** -whitespace
docs/bench/delivery-r3-1018/*/outputs/** -whitespace
docs/bench/delivery-r3-1018/*/judge/** -whitespace
docs/bench/delivery-r2-1017/outputs/** -whitespace
