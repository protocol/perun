diff --git a/server/routes/invoices.js b/server/routes/invoices.js
new file mode 100644
--- /dev/null
+++ b/server/routes/invoices.js
@@ -0,0 +1,13 @@
+const express = require('express');
+const { db } = require('../db');
+const { requireLogin } = require('../auth');
+
+const router = express.Router();
+
+router.get('/invoices/:id', requireLogin, async (req, res) => {
+  const invoice = await db.invoices.findOne({ where: { id: req.params.id } });
+  if (!invoice) return res.status(404).json({ error: 'not found' });
+  res.json(invoice);
+});
+
+module.exports = router;
