+package client
+
+import (
+	"crypto/tls"
+	"net/http"
+	"time"
+)
+
+// NewPaymentsClient returns the HTTP client used for calls to the payments provider.
+func NewPaymentsClient() *http.Client {
+	tr := &http.Transport{
+		TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
+	}
+	return &http.Client{Transport: tr, Timeout: 10 * time.Second}
+}
