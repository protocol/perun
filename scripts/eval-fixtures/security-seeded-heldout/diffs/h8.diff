diff --git a/app/tokens.py b/app/tokens.py
new file mode 100644
--- /dev/null
+++ b/app/tokens.py
@@ -0,0 +1,15 @@
+import hmac
+import secrets
+
+from app.db import load_reset_token, save_reset_token
+
+
+def issue_reset_token(user_id):
+    token = secrets.token_urlsafe(32)
+    save_reset_token(user_id, token)
+    return token
+
+
+def check_reset_token(user_id, presented):
+    stored = load_reset_token(user_id)
+    return stored is not None and hmac.compare_digest(stored, presented)
