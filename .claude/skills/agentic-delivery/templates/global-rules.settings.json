{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "timeout": 5, "command": "python3 \"$HOME/.claude/perun-rules/reply_cap.py\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "timeout": 5, "command": "python3 \"$HOME/.claude/perun-rules/decision_gate.py\"" }] },
      { "hooks": [{ "type": "command", "timeout": 5, "command": "python3 \"$HOME/.claude/perun-rules/reply_cap.py\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [{ "type": "command", "timeout": 5, "command": "python3 \"$HOME/.claude/perun-rules/decision_gate.py\"" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"$HOME/.claude/perun-rules/subagent_start_inject.py\"" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "python3 \"$HOME/.claude/perun-rules/handback_cap.py\"" }] }
    ]
  }
}
