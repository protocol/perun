# Local privacy gate — real internal identifiers are NEVER committed.
# Put real names / company names / internal IDs / hostnames here instead of
# in the committed .banlist.txt. See .banlist.txt for the mechanism.
.banlist.local.txt

# Secrets / environment
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Tooling artifacts (if any linters/tests are ever run in this repo)
node_modules/
dist/
build/
coverage/
*.log
__pycache__/
*.pyc

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Session handoff notes (focus_kit.py handoff): session state, not history
.claude/handoff*.md

# Editor-local rules / skills (maintainer machine; not part of the skill product)
.cursor/

# install.sh skill backups — a prior skill install moved aside on re-install.
# Named .<host>/skill-backups/<skill>-<timestamp>[-N].
# (.cursor/ is already ignored above, which covers .cursor/skill-backups/.)
.claude/skill-backups/
.agents/skill-backups/
.codex/skill-backups/
.gemini/skill-backups/
.opencode/skill-backups/
